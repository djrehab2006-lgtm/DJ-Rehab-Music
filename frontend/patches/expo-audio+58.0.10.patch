+package expo.modules.audio.service
+
+import androidx.media3.common.FlagSet
+import androidx.media3.common.Player
+import androidx.media3.common.Timeline
+import androidx.media3.common.util.UnstableApi
+import java.lang.reflect.InvocationTargetException
+import java.lang.reflect.Method
+import java.lang.reflect.Proxy
+import java.util.concurrent.CopyOnWriteArrayList
+
+// The media session keeps ONE player for its whole life: `player`. Which real player ("deck") it
+// stands for can change. Moving to another deck is reported to the session as an ordinary move to
+// another track of the same player (position jump + media item transition), which is what the lock
+// screen and Bluetooth devices (car displays) already handle when a track is skipped by hand.
+// Replacing the session's player (`MediaSession.setPlayer`) or the session itself is avoided.
+@UnstableApi
+internal class DeckSwitchingPlayer(initial: Player) {
+  private var target: Player = initial
+  private val listeners = CopyOnWriteArrayList<Player.Listener>()
+
+  // Receives every event of the current deck and passes it on to the session's listeners.
+  private val relay = Proxy.newProxyInstance(
+    Player.Listener::class.java.classLoader,
+    arrayOf(Player.Listener::class.java)
+  ) { proxy, method, args ->
+    when (method.name) {
+      "equals" -> proxy === args?.get(0)
+      "hashCode" -> System.identityHashCode(proxy)
+      "toString" -> "DeckSwitchingPlayer.relay"
+      else -> {
+        val forwarded = if (method.name == "onEvents" && args != null) arrayOf(player, args[1]) else args
+        listeners.forEach { call(method, it, forwarded) }
+        null
+      }
+    }
+  } as Player.Listener
+
+  val player: Player = Proxy.newProxyInstance(
+    Player::class.java.classLoader,
+    arrayOf(Player::class.java)
+  ) { proxy, method, args ->
+    when (method.name) {
+      "addListener" -> {
+        listeners.addIfAbsent(args!![0] as Player.Listener)
+        null
+      }
+      "removeListener" -> {
+        listeners.remove(args!![0])
+        null
+      }
+      "equals" -> proxy === args?.get(0)
+      "hashCode" -> System.identityHashCode(proxy)
+      "toString" -> "DeckSwitchingPlayer($target)"
+      else -> call(method, target, args)
+    }
+  } as Player
+
+  init {
+    target.addListener(relay)
+  }
+
+  /** Stops listening to the current deck. Called when the session is closed. */
+  fun detach() {
+    target.removeListener(relay)
+  }
+
+  private fun call(method: Method, receiver: Any, args: Array<out Any?>?): Any? = try {
+    method.invoke(receiver, *(args ?: emptyArray()))
+  } catch (e: InvocationTargetException) {
+    throw e.targetException
+  }
+
+  private fun positionOf(player: Player): Player.PositionInfo {
+    val timeline = player.currentTimeline
+    val index = player.currentMediaItemIndex
+    val periodIndex = player.currentPeriodIndex
+    val hasWindow = !timeline.isEmpty && index < timeline.windowCount
+    return Player.PositionInfo(
+      if (hasWindow) timeline.getWindow(index, Timeline.Window()).uid else null,
+      index,
+      player.currentMediaItem,
+      if (hasWindow && periodIndex < timeline.periodCount) timeline.getUidOfPeriod(periodIndex) else null,
+      periodIndex,
+      player.currentPosition,
+      player.contentPosition,
+      -1,
+      -1
+    )
+  }
+
+  /**
+   * Makes [next] the player behind the session. With [trackChanged] the session is told that the
+   * player moved to another track; without it only the differences in play state are reported.
+   */
+  fun switchTo(next: Player, trackChanged: Boolean) {
+    val previous = target
+    val oldPosition = positionOf(previous)
+    val wasPlayWhenReady = previous.playWhenReady
+    val oldState = previous.playbackState
+    val wasPlaying = previous.isPlaying
+
+    previous.removeListener(relay)
+    target = next
+    next.addListener(relay)
+
+    val flags = FlagSet.Builder()
+    if (trackChanged) {
+      val newPosition = positionOf(next)
+      val item = next.currentMediaItem
+      listeners.forEach {
+        it.onPositionDiscontinuity(oldPosition, newPosition, Player.DISCONTINUITY_REASON_AUTO_TRANSITION)
+      }
+      listeners.forEach { it.onMediaItemTransition(item, Player.MEDIA_ITEM_TRANSITION_REASON_AUTO) }
+      flags.add(Player.EVENT_POSITION_DISCONTINUITY).add(Player.EVENT_MEDIA_ITEM_TRANSITION)
+    }
+    if (wasPlayWhenReady != next.playWhenReady) {
+      listeners.forEach {
+        it.onPlayWhenReadyChanged(next.playWhenReady, Player.PLAY_WHEN_READY_CHANGE_REASON_USER_REQUEST)
+      }
+      flags.add(Player.EVENT_PLAY_WHEN_READY_CHANGED)
+    }
+    if (oldState != next.playbackState) {
+      listeners.forEach { it.onPlaybackStateChanged(next.playbackState) }
+      flags.add(Player.EVENT_PLAYBACK_STATE_CHANGED)
+    }
+    if (wasPlaying != next.isPlaying) {
+      listeners.forEach { it.onIsPlayingChanged(next.isPlaying) }
+      flags.add(Player.EVENT_IS_PLAYING_CHANGED)
+    }
+    val events = Player.Events(flags.build())
+    if (events.size() > 0) {
+      listeners.forEach { it.onEvents(player, events) }
+    }
+  }
+}
